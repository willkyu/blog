// ==============================
// Custom style
// ==============================
//  Also You can override the variables in variable.styl to customize the style

.header-actions,
.mobile-actions
  display flex
  align-items center
  gap .25rem

.icon-button
  appearance none
  border 0
  background rgba(45, 150, 189, .1)
  color inherit
  width 2.25rem
  height 2.25rem
  padding .4rem
  border-radius 50%
  display inline-flex
  align-items center
  justify-content center
  cursor pointer
  line-height 1
  transition color .2s ease, background-color .2s ease, transform .2s ease

  &:hover
    color $light-global-link-hover-color
    background rgba(45, 150, 189, .18)
    transform translateY(-1px)

  &:focus-visible
    outline 2px solid $light-global-link-hover-color
    outline-offset 2px

  .dark-theme &
    color $dark-global-link-color
    background rgba(168, 191, 163, .14)

    &:hover
      color $dark-global-link-hover-color
      background rgba(168, 191, 163, .24)

    &:focus-visible
      outline-color $dark-global-link-color

  svg
    width 1.25rem
    height 1.25rem
    fill none
    stroke currentColor
    stroke-width 1.8
    stroke-linecap round
    stroke-linejoin round

.theme-switching *,
.theme-switching *::before,
.theme-switching *::after
  transition none !important

::view-transition-old(root),
::view-transition-new(root)
  animation-duration .24s
  animation-timing-function ease-in-out

@media (prefers-reduced-motion: reduce)
  ::view-transition-old(root),
  ::view-transition-new(root)
    animation none

.theme-toggle
  .moon-icon
    display none

.dark-theme .theme-toggle
  .sun-icon
    display none
  .moon-icon
    display block

.links
  display flex
  justify-content center
  align-items center
  gap 1rem

  .link-item
    width 2.5rem
    height 2.5rem
    padding 0
    border-radius 50%
    display inline-flex
    align-items center
    justify-content center
    background transparent !important
    box-shadow none !important

    &:focus-visible
      outline 2px solid $light-global-link-hover-color
      outline-offset 2px

  .iconfont
    line-height 1

.page-heading
  margin 0 0 1.5rem
  font-size 2rem
  line-height 1.5
  font-family var(--font-ui)
  font-weight 650

.adaptive-pagination
  padding-top 1.25rem
  gap .8rem

  .page-number
    appearance none
    border 0
    border-bottom 1px solid transparent
    background transparent
    color $light-pagination-link-color
    min-width 2rem
    padding .35rem .5rem
    cursor pointer
    font-family var(--font-ui)
    font-weight 650

    &:hover,
    &[aria-current="page"]
      color $light-pagination-link-active-color
      border-bottom-color currentColor

    .dark-theme &
      color $dark-pagination-link-color

      &:hover,
      &[aria-current="page"]
        color $dark-global-link-color

.archive-item[hidden],
.archive-year[hidden]
  display none !important

.search-dialog[hidden]
  display none

.search-dialog
  position fixed
  inset 0
  z-index 1000
  display grid
  place-items start center
  padding 10vh 1rem 1rem

.search-backdrop
  position absolute
  inset 0
  width 100%
  height 100%
  border 0
  background rgba(20, 22, 24, .58)
  cursor default

.search-panel
  position relative
  z-index 1
  width min(42rem, 100%)
  max-height 78vh
  overflow auto
  box-sizing border-box
  padding 1.2rem
  border 1px solid $light-border-color
  border-radius 14px
  background $light-background-color
  box-shadow 0 18px 60px rgba(0, 0, 0, .22)

  .dark-theme &
    border-color $dark-border-color
    background $dark-background-color

.search-header
  display flex
  align-items center
  justify-content space-between

  h2
    margin 0

.search-input-wrap
  display block
  margin 1rem 0 .5rem

  input
    width 100%
    box-sizing border-box
    padding .8rem 1rem
    border 1px solid $light-border-color
    border-radius 9px
    color $light-font-color
    background #fff
    font 1rem var(--font-ui)

    &:focus
      outline 2px solid $light-global-link-hover-color
      border-color transparent

    .dark-theme &
      color $dark-font-color
      background #222326
      border-color $dark-border-color

      &:focus
        outline-color $dark-global-link-color

.search-status
  color $light-font-secondary-color
  font-size .9rem

  .dark-theme &
    color $dark-font-secondary-color

.search-results
  margin 1rem 0 0
  padding 0
  list-style none

  li + li
    border-top 1px solid $light-border-color

    .dark-theme &
      border-color $dark-border-color

  a
    display flex
    flex-direction column
    gap .1rem
    padding .7rem .2rem

  small
    color $light-font-secondary-color

    .dark-theme &
      color $dark-font-secondary-color

.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

body.search-open
  overflow hidden
