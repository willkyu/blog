// post structure
.post-wrap
  p
    font-size 1em
    margin 1em 0 1em 0
  .post-header h1
    margin 0 !important

  .post-title
    font-size 2em
    line-height 1.5em

  .post-meta
    display flex
    flex-wrap wrap
    align-items center
    gap .25rem .85rem
    color rgba(85, 85, 85, 0.52941) !important
    .dark-theme &
      color $dark-font-secondary-color !important

    a
      color $light-post-link-color
      .dark-theme &
        color $dark-post-link-color

      &:hover
        color $light-post-link-hover-color
        .dark-theme &
          color $dark-post-link-hover-color

    .post-category a:not(:last-child)::after,
    .post-tag-list a:not(:last-child)::after
      content " / "
      color $light-font-secondary-color

    .dark-theme &
      .post-category a:not(:last-child)::after,
      .post-tag-list a:not(:last-child)::after
        color $dark-font-secondary-color
