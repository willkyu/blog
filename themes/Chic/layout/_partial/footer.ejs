<%
const footerValue = page.footer !== undefined ? page.footer : theme.footer.text;
const showFooter = footerValue !== false;
const footerText = String(footerValue || '')
    .replace(/\{year\}/g, new Date().getFullYear())
    .replace(/\{author\}/g, config.author || '');
%>
<% if(showFooter){ %>
<footer id="footer" class="footer">
    <div class="copyright">
        <span class="copyright-mark" aria-hidden="true"><%- theme.footer.icon || '©' %></span>
        <span><%- footerText %></span>
        <% if(theme.statistics && theme.statistics.busuanzi && !page.hidden){ %>
        <span id="busuanzi_container_site_pv" class="site-stat" style="display:none">
            · <%- theme.statistics.site_label %> <span id="busuanzi_value_site_pv"></span>
        </span>
        <% } %>
    </div>
</footer>
<% } %>
