<div class="post-wrap archive" data-adaptive-list>
    <% if(typeof heading !== 'undefined' && heading){ %>
        <h2 class="post-title page-heading"><%- heading %></h2>
    <% } %>
    <% var last_year = ''; %>
    <% page.posts.each(function (post) { %>
        <% var cur_year = post.date.year(); %>

        <% if(last_year !== cur_year){ %>
            <h3 class="archive-year" data-archive-year="<%- cur_year %>"><%- cur_year %></h3>
        <% last_year = cur_year; } %>

        <article class="archive-item" data-adaptive-item data-year="<%- cur_year %>">
            <a class="archive-item-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
            <span class="archive-item-date"><%- date(post.date, theme.date_format) %></span>
        </article>
    <% }) %>
    <nav class="pagination adaptive-pagination" data-adaptive-pagination aria-label="Post pagination"></nav>
</div>
